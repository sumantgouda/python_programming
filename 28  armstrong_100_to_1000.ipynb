   "source": [
    "# 28.  Print all the armstrong numbers in the range of 100 to 1000\n",
    "for i in range(100,1000):\n",
    "    a=i%10\n",
    "    n=i//10\n",
    "    b=n%10\n",
    "    c=n//10\n",
    "    if(a**3)+(b**3)+(c**3)==i:\n",
    "        print(i)"
   ]
