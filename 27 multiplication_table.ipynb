    "# 27. Print multiplication table from 1 to 10\n",
    "for i in range(1,11):\n",
    "    for j in range(1,11):\n",
    "        if j==1:\n",
    "            print(end=\"\\t\")\n",
    "        print(f\"{i}X{j}={i*j}\",end=\"\\t\")\n",
    "    print()            "
